# ==============================================================================
# Telegram Media Downloader Bot - Environment Configuration
# ==============================================================================

# Telegram Bot API Token from @BotFather (Required)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ123456789

# Custom / Local Telegram Bot API Server (Optional)
# If using a local bot API server, standard upload limit increases from 50MB to 2000MB (2GB).
# BOT_API_SERVER=http://telegram-bot-api:8081

# Storage & Temporary Files
DOWNLOAD_DIR=/tmp/downloads
MIN_FREE_DISK_GB=3.0
JANITOR_INTERVAL_MINUTES=15
JANITOR_MAX_AGE_MINUTES=30

# Concurrency Guardrails
MAX_GLOBAL_CONCURRENT=3
MAX_USER_CONCURRENT=1
MAX_GROUP_CONCURRENT=2

# Multi-Tier Rate Limiting (Requests per minute)
USER_RATE_LIMIT_PER_MINUTE=5
GROUP_RATE_LIMIT_PER_MINUTE=10

# Subprocess & Worker Guardrails
DOWNLOAD_TIMEOUT_SECONDS=600
FFMPEG_THREADS=2
MAX_FILE_SIZE_MB=50

# Executables & Downloader Engines
# OMNIGET_BIN=/usr/local/bin/omniget-cli
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg

# UX Progress Throttling (Seconds between message edits to avoid Telegram 429 FloodWait)
PROGRESS_UPDATE_INTERVAL_SECONDS=4.0
MAX_LINKS_PER_MESSAGE=2

# Redis Backend (Optional - defaults to in-memory queue & locks if omitted)
# REDIS_URL=redis://redis:6379/0

# Global Bot Administrator Telegram User IDs (Comma-separated)
ADMIN_IDS=123456789,987654321
